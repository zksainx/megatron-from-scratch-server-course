# Optional preset for later performance experiments on B200/GB200-class GPUs.
# This is intentionally not the default teaching run.

TRAIN_ROOT=${TRAIN_ROOT:-/sgl-workspace/zkx/train}
MEGATRON_ROOT=${MEGATRON_ROOT:-$TRAIN_ROOT/Megatron-LM}
COURSE_ROOT=${COURSE_ROOT:-$TRAIN_ROOT/megatron-from-scratch-server-course}
RUN_ROOT=${RUN_ROOT:-$COURSE_ROOT/runs}

GPUS_PER_NODE=${GPUS_PER_NODE:-4}
TP_SIZE=${TP_SIZE:-2}
PP_SIZE=${PP_SIZE:-1}
CP_SIZE=${CP_SIZE:-2}

SEQ_LENGTH=${SEQ_LENGTH:-4096}
MICRO_BATCH_SIZE=${MICRO_BATCH_SIZE:-1}
GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE:-16}

NUM_LAYERS=${NUM_LAYERS:-32}
HIDDEN_SIZE=${HIDDEN_SIZE:-4096}
FFN_HIDDEN_SIZE=${FFN_HIDDEN_SIZE:-14336}
NUM_ATTENTION_HEADS=${NUM_ATTENTION_HEADS:-32}
NUM_QUERY_GROUPS=${NUM_QUERY_GROUPS:-8}

PRECISION_ARGS="--bf16 --fp8-format hybrid --fp8-amax-history-len 1024 --fp8-amax-compute-algo max --fp8-param-gather"

