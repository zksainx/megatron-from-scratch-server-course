# Source this file from scripts, or override any variable in the shell.

TRAIN_ROOT=${TRAIN_ROOT:-/sgl-workspace/zkx/train}
MEGATRON_ROOT=${MEGATRON_ROOT:-$TRAIN_ROOT/Megatron-LM}
COURSE_ROOT=${COURSE_ROOT:-$TRAIN_ROOT/megatron-from-scratch-server-course}
RUN_ROOT=${RUN_ROOT:-$COURSE_ROOT/runs}

GPUS_PER_NODE=${GPUS_PER_NODE:-4}
MASTER_ADDR=${MASTER_ADDR:-localhost}
MASTER_PORT=${MASTER_PORT:-6010}
NUM_NODES=${NUM_NODES:-1}
NODE_RANK=${NODE_RANK:-0}

SEQ_LENGTH=${SEQ_LENGTH:-512}
MICRO_BATCH_SIZE=${MICRO_BATCH_SIZE:-2}
GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE:-32}
TRAIN_ITERS=${TRAIN_ITERS:-20}
EVAL_ITERS=${EVAL_ITERS:-5}
SAVE_INTERVAL=${SAVE_INTERVAL:-20}
EVAL_INTERVAL=${EVAL_INTERVAL:-20}

NUM_LAYERS=${NUM_LAYERS:-12}
HIDDEN_SIZE=${HIDDEN_SIZE:-768}
FFN_HIDDEN_SIZE=${FFN_HIDDEN_SIZE:-3072}
NUM_ATTENTION_HEADS=${NUM_ATTENTION_HEADS:-12}
VOCAB_SIZE=${VOCAB_SIZE:-50304}

LR=${LR:-6.0e-4}
MIN_LR=${MIN_LR:-6.0e-5}

GPT2_VOCAB_FILE=${GPT2_VOCAB_FILE:-$TRAIN_ROOT/LLMs-from-scratch/ch02/02_bonus_bytepair-encoder/gpt2_model/encoder.json}
GPT2_MERGE_FILE=${GPT2_MERGE_FILE:-$TRAIN_ROOT/LLMs-from-scratch/ch02/02_bonus_bytepair-encoder/gpt2_model/vocab.bpe}

